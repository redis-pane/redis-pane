# Shared look for every tape. Pulled in with `Source _settings.tape`.
# Nothing here is per-scenario; change it and re-render the whole set so the
# recordings keep matching.

Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 720
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 60ms
Set Framerate 12
